# ESP32-S3 (FNK0104N: S3R8, 8 MB octal PSRAM, qio_opi)
# NOTE: boot-log ground truth (2026-09-13, on-device) reports
# "SPI Flash Size : 4MB" for this unit — do not assume 16MB from
# datasheet/vendor listing without re-verifying via serial monitor.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Partition table (3 MB app slot + spiffs, fits a 4 MB chip with margin;
# see partitions.csv — a prior 4M app + 0x180000 spiffs table silently
# overflowed a 4 MB chip and produced a boot-time
# "partition X invalid ... exceeds flash chip size" hang, blank screen,
# no panic. Recompute headroom here if either partition grows.)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# RTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Octal PSRAM (R8) — LVGL framebuffers live here, DSP arrays stay in internal SRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Wi-Fi CSI (in-IDF API; esp-csi repo NOT required as a component)
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# Console on USB Serial/JTAG (FNK0104N native USB-CDC)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL (Kconfig-managed lv_conf)
CONFIG_LV_COLOR_DEPTH_16=y

# FATFS long filenames (csi_telemetry.csv exceeds 8.3)
CONFIG_FATFS_LFN_STACK=y
